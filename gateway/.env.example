# Qingyu Memory Gateway. Copy this file to gateway/.env and edit it.
# Outside APP_ENV=test the process refuses to start until the three secrets
# below are distinct non-example values and DATABASE_URL is set.
# Startup errors point here.

# Display name (FastAPI title and the startup log).
APP_NAME=Qingyu Memory Gateway

# development, production, or test. test skips the secret checks and the
# startup DATABASE_URL requirement. Do not run a real process as test.
APP_ENV=development

# Address recorded in settings and the startup log. uvicorn binds the --host
# you pass on the command line, not this value. Keep 127.0.0.1 unless you
# mean to document a different address. The Compose app listens on 0.0.0.0
# inside the container and is published on 127.0.0.1:8000.
HOST=127.0.0.1

# Port recorded in settings and the startup log. uvicorn binds --port.
PORT=8000

# Bearer token for import, archive, and other operator routes.
# Required outside APP_ENV=test. Must be a non-example secret and must differ
# from the evidence-read token and the cursor signing key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Bearer token for GET /api/v1/evidence/... and conversation export.
# Required outside test. Must differ from API_TOKEN and the cursor key.
EVIDENCE_READ_API_TOKEN=

# HMAC key for evidence pagination cursors. It is not a bearer token.
# Required outside test. Must differ from both tokens above.
EVIDENCE_CURSOR_SIGNING_KEY=

# Optional comma-separated tokens accepted beside API_TOKEN.
# Add the next token, reload, then remove the old one. Tokens must not
# contain commas. A blank entry or a duplicate is rejected.
API_TOKENS=

# Optional comma-separated tokens accepted beside EVIDENCE_READ_API_TOKEN.
# Same overlap rules as API_TOKENS. None of them may match an API token.
EVIDENCE_READ_API_TOKENS=

# Password for the qingyu database role. Compose reads it for the db service
# and, for the app service, inserts it into that service's own DATABASE_URL.
# Use a URL-safe value (letters, digits, hyphen, underscore). Characters such
# as @ : / % # ? or $ break the Compose URL, which is not percent-encoded.
# The host-run DATABASE_URL below is separate: percent-encode those characters
# there if you use them.
POSTGRES_PASSWORD=

# Host-run connection string. Compose does not expand variables in this file,
# so replace <POSTGRES_PASSWORD> with the same password as above.
# The Compose app service does not read this value; it connects to host db.
# Leave 127.0.0.1 here so uvicorn on the host still reaches published Postgres.
DATABASE_URL=postgresql+psycopg://qingyu:<POSTGRES_PASSWORD>@127.0.0.1:5432/qingyu

# Host directory for archive objects, manifests, and staging. Replace the
# placeholder with a writable absolute path before a host-run process.
# The Compose app service ignores this and stores archives at /data.
ARCHIVE_ROOT=<repo>/data

# Largest accepted import or archive upload, in bytes (default 512 MiB).
IMPORT_UPLOAD_MAX_BYTES=536870912

# Cap, in bytes, for every request that is not an archive or import upload.
REQUEST_BODY_MAX_BYTES=1048576

# Per-process fixed window. /health and /health/ready are exempt.
# Not shared across processes.
RATE_LIMIT_ENABLED=true

# Requests allowed per window for one client address.
RATE_LIMIT_REQUESTS=600

# Window length in seconds.
RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated CIDRs or IPs of reverse proxies that may set the client
# address. Empty (the default) ignores X-Forwarded-For and X-Real-IP and keys
# the limit on the TCP peer, so a proxy in front of the process shares one
# bucket across clients. For nginx on this machine use 127.0.0.1/32,::1/128.
# Only list hops you run. Trusting a wide range lets those peers' clients pick
# a bucket by sending the header themselves.
TRUSTED_PROXIES=

# Days to keep failed staging imports before cleanup deletes them.
STAGING_FAILED_RETENTION_DAYS=7

# Seconds between staging cleanup passes.
STAGING_CLEANUP_INTERVAL_SECONDS=300

# Maximum failed-stage candidates one cleanup pass handles.
STAGING_CLEANUP_MAX_CANDIDATES=100

# DEBUG, INFO, WARNING, ERROR, or CRITICAL. An unknown level falls back to INFO.
LOG_LEVEL=INFO

# text is one line per record. json is one JSON object per line, including
# request_id. Access lines never include the query string, headers, tokens, or bodies.
LOG_FORMAT=text

# Prometheus text at GET /metrics. Off unless this is true. The series are
# per process: request count and latency by route template and status.
METRICS_ENABLED=false

# Bearer token for GET /metrics when metrics are enabled. The API token is
# not accepted unless you copy it here. Empty leaves /metrics open to anyone
# who can reach the port, so keep that port on localhost or set a token.
METRICS_TOKEN=
