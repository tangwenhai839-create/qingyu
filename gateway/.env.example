APP_NAME=Qingyu Memory Gateway
APP_ENV=development
HOST=127.0.0.1
PORT=8000
API_TOKEN=
EVIDENCE_READ_API_TOKEN=
EVIDENCE_CURSOR_SIGNING_KEY=
# Optional comma-separated tokens that stay active beside the primary ones.
# Add the next token, reload, then remove the old one. Tokens must not contain commas.
API_TOKENS=
EVIDENCE_READ_API_TOKENS=
# Local PostgreSQL credentials (read by docker compose and the application):
# Set POSTGRES_PASSWORD and make sure the password in DATABASE_URL uses the same value.
POSTGRES_PASSWORD=
# Replace <POSTGRES_PASSWORD> below with the same value as above
# (no variable expansion here).
DATABASE_URL=postgresql+psycopg://qingyu:<POSTGRES_PASSWORD>@127.0.0.1:5432/qingyu
ARCHIVE_ROOT=<repo>/data
IMPORT_UPLOAD_MAX_BYTES=536870912
# Cap for every request that is not an archive or import upload.
REQUEST_BODY_MAX_BYTES=1048576
# Per-process fixed window. /health is exempt. Not shared across processes.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated CIDRs or IPs of reverse proxies that may set the client
# address. Empty (the default) ignores X-Forwarded-For and X-Real-IP and keys
# the limit on the TCP peer, so a proxy in front of the process shares one
# bucket across clients. For nginx on this machine use 127.0.0.1/32,::1/128.
# Only list hops you run. Trusting a wide range lets those peers' clients pick
# a bucket by sending the header themselves.
TRUSTED_PROXIES=
STAGING_FAILED_RETENTION_DAYS=7
STAGING_CLEANUP_INTERVAL_SECONDS=300
STAGING_CLEANUP_MAX_CANDIDATES=100
LOG_LEVEL=INFO
# text is one line per record. json is one JSON object per line, including
# request_id. Access lines never include the query string, headers, tokens, or bodies.
LOG_FORMAT=text
# Prometheus text at GET /metrics. Off unless this is true. The series are
# per process: request count and latency by route template and status.
# Set METRICS_TOKEN to require Authorization: Bearer <token>. The API token
# is not accepted unless you copy it here. An empty token leaves the endpoint
# open to anyone who can reach the port, so keep that port on localhost or set a token.
METRICS_ENABLED=false
METRICS_TOKEN=
